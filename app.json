            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          },
          {
            "name": "state",
            "type": "dropdown",
            "values": [
              {
                "id": "cleaning",
                "label": {
                  "en": "Cleaning",
                  "de": "Staubsaugen"
                }
              },
              {
                "id": "spot_cleaning",
                "label": {
                  "en": "Spot cleaning",
                  "de": "Spot-Reinigung"
                }
