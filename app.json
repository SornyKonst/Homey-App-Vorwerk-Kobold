        "title": {
          "en": "A history entry was added",
          "de": "Ein Verlaufseintrag wurde hinzugefügt"
        },
        "hint": {
          "en": "The first cleaning-history import after connecting or restarting does not trigger this card. Elapsed time includes pauses and charging. Area and elapsed-time tokens are empty if unknown.",
          "de": "Der erste Import des Reinigungsverlaufs nach Anmeldung oder Neustart löst diese Karte nicht aus. Die Gesamtdauer enthält Pausen und Ladeunterbrechungen. Fläche und Dauer sind leer, wenn unbekannt."
        },
        "tokens": [
          {
            "name": "started_at",
            "type": "string",
            "title": {
              "en": "Start time",
              "de": "Beginn"
            }
          },
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "History status code",
              "de": "Statuscode im Verlauf"
            }
          },
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Cleaned area (m²)",
              "de": "Gereinigte Fläche (m²)"
