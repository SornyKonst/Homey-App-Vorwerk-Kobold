  "flow": {
    "actions": [
      {
        "title": {
          "en": "Clean an area",
          "de": "Bereich reinigen"
        },
        "titleFormatted": {
          "en": "Clean [[area]]",
          "de": "Reinige [[area]]"
        },
        "hint": {
          "en": "Starts a new cleaning job from the charging station in a saved MyKobold area. Stop any running or paused job first.",
          "de": "Startet eine neue Reinigung von der Ladestation aus in einem gespeicherten MyKobold-Bereich. Stoppe zuerst einen laufenden oder pausierten Auftrag."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vr300&capabilities=kobold_area"
          },
          {
            "name": "area",
            "type": "autocomplete",
            "title": {
              "en": "Area",
              "de": "Bereich"
            },
            "placeholder": {
              "en": "Choose an area",
              "de": "Bereich auswählen"
            }
          }
        ],
        "id": "clean_area"
      },
      {
        "title": {
          "en": "Refresh available areas",
          "de": "Verfügbare Bereiche aktualisieren"
        },
        "hint": {
          "en": "Reads the areas saved in MyKobold without starting the robot.",
          "de": "Liest die in MyKobold gespeicherten Bereiche neu ein, ohne eine Reinigung zu starten."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vr300&capabilities=kobold_area"
          }
        ],
        "id": "refresh_areas"
      },
      {
        "id": "start_cleaning",
        "title": {
          "en": "Start cleaning",
          "de": "Reinigung starten"
        },
        "hint": {
          "en": "Starts a cleaning or resumes a paused cleaning job.",
          "de": "Startet eine Reinigung oder setzt eine pausierte Reinigung fort."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "pause_cleaning",
        "title": {
          "en": "Pause cleaning",
          "de": "Reinigung pausieren"
        },
        "hint": {
          "en": "Pauses the current job so it can be resumed later.",
          "de": "Pausiert den laufenden Auftrag, damit er später fortgesetzt werden kann."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "resume_cleaning",
        "title": {
          "en": "Resume cleaning",
          "de": "Reinigung fortsetzen"
        },
        "hint": {
          "en": "Resumes a paused job. Does not start a new job.",
          "de": "Setzt einen pausierten Auftrag fort. Startet keinen neuen Auftrag."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "stop_cleaning",
        "title": {
          "en": "Stop cleaning",
          "de": "Reinigung stoppen"
        },
        "hint": {
          "en": "Stops the current job. Use Pause cleaning if you want to resume it later.",
          "de": "Stoppt den laufenden Auftrag. Verwende zum späteren Fortsetzen stattdessen Reinigung pausieren."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "return_to_base",
        "title": {
          "en": "Return to charging station",
          "de": "Zur Ladestation zurückkehren"
        },
        "hint": {
          "en": "Pauses an active cleaning first if the robot requires it, then requests a return to the station.",
          "de": "Pausiert bei Bedarf zuerst die laufende Reinigung und fordert dann die Rückkehr zur Station an."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "refresh_status",
        "title": {
          "en": "Refresh robot status",
          "de": "Roboterstatus aktualisieren"
        },
        "hint": {
          "en": "Reads the current robot status without starting a cleaning.",
          "de": "Liest den aktuellen Roboterstatus, ohne eine Reinigung zu starten."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "refresh_robot_data",
        "title": {
          "en": "Refresh additional robot data",
          "de": "Zusätzliche Roboterdaten aktualisieren"
        },
        "hint": {
          "en": "Only reads status, device information and the existing robot schedule. Does not start cleaning or change settings.",
          "de": "Liest nur Status, Geräteinformationen und den bestehenden Roboterzeitplan. Startet keine Reinigung und verändert keine Einstellungen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "refresh_history",
        "title": {
          "en": "Refresh cleaning history and maps",
          "de": "Reinigungsverlauf und Karten aktualisieren"
        },
        "hint": {
          "en": "Only reads the cloud account. Does not start or change a cleaning.",
          "de": "Liest nur das Cloud-Konto. Startet oder verändert keine Reinigung."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300&capabilities=kobold_last_cleaned_area"
          }
        ]
      },
      {
        "id": "clean",
        "highlight": true,
        "title": {
          "en": "Start cleaning",
          "de": "Mit Staubsaugen anfangen"
        },
        "deprecated": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "spot_clean",
        "title": {
          "en": "Start spot cleaning",
          "de": "Mit Spot-Reinigung anfangen"
        },
        "deprecated": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "dock",
        "highlight": true,
        "title": {
          "en": "Return to dock",
          "de": "Zu Ladestation zurückkehren"
        },
        "deprecated": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      },
      {
        "id": "stop",
        "highlight": true,
        "title": {
          "en": "Stop",
          "de": "Stop"
        },
        "deprecated": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vr300"
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "cleaning_started",
        "title": {
