{
  "id": "community.kobold.vr300",
  "version": "0.2.4",
  "compatibility": ">=12.9.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#007A53",
  "name": {
    "en": "Vorwerk Kobold VR200/VR300",
    "de": "Vorwerk Kobold VR200/VR300"
  },
  "description": {
    "en": "Every room at the right time",
    "de": "Jeder Raum zur richtigen Zeit"
  },
  "category": "appliances",
  "tags": {
    "en": [
      "Kobold",
      "VR200",
      "VR300",
      "Vorwerk",
      "vacuum",
      "cleaning"
    ],
    "de": [
      "Kobold",
      "VR200",
      "VR300",
      "Vorwerk",
      "Staubsauger",
      "Reinigung"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "api": {
    "refreshDeviceRobotData": {
      "method": "POST",
      "path": "/robot-data"
    },
    "getAreaDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "refreshDeviceAreas": {
      "method": "POST",
      "path": "/areas"
    },
    "selectDeviceArea": {
      "method": "PUT",
      "path": "/selection"
    },
    "startDeviceArea": {
      "method": "POST",
      "path": "/start"
    },
    "refreshDeviceHistory": {
      "method": "POST",
      "path": "/history"
    },
    "getDeviceHistoryImage": {
      "method": "GET",
      "path": "/image"
    }
  },
  "author": {
    "name": "Lindner IT Solutions"
  },
  "source": "https://github.com/SornyKonst/Homey-App-Vorwerk-Kobold",
  "homepage": "https://github.com/SornyKonst/Homey-App-Vorwerk-Kobold",
  "bugs": {
    "url": "https://github.com/SornyKonst/Homey-App-Vorwerk-Kobold/issues"
  },
  "support": "https://github.com/SornyKonst/Homey-App-Vorwerk-Kobold/issues"
}
